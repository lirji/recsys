<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.ad.persistence.mapper.addb.AdEmbeddingMapper">
    <resultMap id="match" type="com.recsys.ad.persistence.mapper.addb.AdEmbeddingMapper$AdMatch">
        <constructor><arg column="ad_id" javaType="_long"/><arg column="sim" javaType="_double"/></constructor>
    </resultMap>
    <select id="nearestAds" resultMap="match">
        SELECT ad_id, COALESCE(1 - (embedding &lt;=> #{vector,jdbcType=OTHER}),0) AS sim FROM ad_embedding
        ORDER BY embedding &lt;=> #{vector,jdbcType=OTHER} LIMIT #{limit}
    </select>
</mapper>
