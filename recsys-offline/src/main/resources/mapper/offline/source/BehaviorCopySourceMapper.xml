<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.offline.persistence.mapper.source.BehaviorCopySourceMapper">
    <resultMap id="behavior" type="com.recsys.offline.persistence.model.BehaviorLogRow">
        <constructor>
            <arg name="id" column="id" javaType="_long"/>
            <arg name="userId" column="user_id" javaType="java.lang.Long"/>
            <arg name="itemId" column="item_id" javaType="java.lang.Long"/>
            <arg name="action" column="action" javaType="java.lang.String"/>
            <arg name="value" column="value" javaType="java.lang.Double"/>
            <arg name="scene" column="scene" javaType="java.lang.String"/>
            <arg name="bucket" column="bucket" javaType="java.lang.String"/>
            <arg name="timestamp" column="ts" javaType="java.sql.Timestamp"/>
            <arg name="position" column="position" javaType="java.lang.Integer"/>
            <arg name="exposureId" column="exposure_id" javaType="java.lang.String"/>
        </constructor>
    </resultMap>
    <select id="since" resultMap="behavior" useCache="false">
        SELECT id,user_id,item_id,action,value,scene,bucket,ts,position,exposure_id
        FROM user_behavior WHERE id &gt; #{since} ORDER BY id
    </select>
</mapper>
