<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.offline.persistence.mapper.source.ItemCopySourceMapper">
    <resultMap id="item" type="com.recsys.offline.persistence.model.ItemCatalogCopyRow">
        <constructor>
            <arg name="itemId" column="item_id" javaType="_long"/>
            <arg name="title" column="title" javaType="java.lang.String"/>
            <arg name="category" column="category" javaType="java.lang.String"/>
            <arg name="tags" column="tags" javaType="java.util.List" typeHandler="com.recsys.persistence.typehandler.TextListTypeHandler"/>
            <arg name="description" column="description" javaType="java.lang.String"/>
            <arg name="popularity" column="popularity" javaType="java.lang.Double"/>
        </constructor>
    </resultMap>
    <select id="items" resultMap="item" useCache="false">
        SELECT item_id,title,category,tags,description,popularity FROM item
    </select>
</mapper>
