<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.offline.persistence.mapper.manual.R9EmbeddingMapper">
    <delete id="deleteMindVersion">
        DELETE FROM multi_interest_item_embedding WHERE model_version=#{version}
    </delete>
    <insert id="insertMind">
        INSERT INTO multi_interest_item_embedding(model_version,item_id,embedding)
        VALUES(#{row.version},#{row.id},#{row.embedding,jdbcType=OTHER,typeHandler=org.apache.ibatis.type.ObjectTypeHandler})
    </insert>
    <delete id="deleteGraphUserVersion">
        DELETE FROM graph_user_embedding WHERE model_version=#{version}
    </delete>
    <insert id="insertGraphUser">
        INSERT INTO graph_user_embedding(model_version,user_id,embedding)
        VALUES(#{row.version},#{row.id},#{row.embedding,jdbcType=OTHER,typeHandler=org.apache.ibatis.type.ObjectTypeHandler})
    </insert>
    <delete id="deleteGraphItemVersion">
        DELETE FROM graph_item_embedding WHERE model_version=#{version}
    </delete>
    <insert id="insertGraphItem">
        INSERT INTO graph_item_embedding(model_version,item_id,embedding)
        VALUES(#{row.version},#{row.id},#{row.embedding,jdbcType=OTHER,typeHandler=org.apache.ibatis.type.ObjectTypeHandler})
    </insert>
</mapper>
