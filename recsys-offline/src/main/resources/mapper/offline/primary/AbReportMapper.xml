<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.offline.persistence.mapper.primary.AbReportMapper">
    <resultMap id="bucket" type="com.recsys.offline.persistence.mapper.primary.AbReportMapper$Bucket">
        <constructor>
            <arg name="bucket" column="bucket" javaType="java.lang.String"/>
            <arg name="impressions" column="impressions" javaType="_long"/>
            <arg name="clicks" column="clicks" javaType="_long"/>
            <arg name="users" column="users" javaType="_long"/>
        </constructor>
    </resultMap>
    <resultMap id="post" type="com.recsys.offline.persistence.mapper.primary.AbReportMapper$PostPeriod">
        <constructor>
            <arg name="userId" column="user_id" javaType="_long"/>
            <arg name="bucket" column="bucket" javaType="java.lang.String"/>
            <arg name="impressions" column="impressions" javaType="_long"/>
            <arg name="clicks" column="clicks" javaType="_long"/>
            <arg name="firstImpression" column="first_impression" javaType="java.sql.Timestamp"/>
        </constructor>
    </resultMap>
    <resultMap id="pre" type="com.recsys.offline.persistence.mapper.primary.AbReportMapper$PrePeriod">
        <constructor>
            <arg name="userId" column="user_id" javaType="_long"/>
            <arg name="impressions" column="impressions" javaType="_long"/>
            <arg name="clicks" column="clicks" javaType="_long"/>
        </constructor>
    </resultMap>
    <sql id="sourceTable"><choose><when test="source.name() == 'BEHAVIOR_LOG'">behavior_log</when><otherwise>user_behavior</otherwise></choose></sql>
    <sql id="sceneFilter"><if test="scene != null">AND b.scene=#{scene}</if></sql>
    <sql id="untilFilter"><if test="until != null">AND b.ts &lt; #{until}::timestamp</if></sql>
    <sql id="totals">
        COUNT(*) FILTER (WHERE b.action='IMPRESSION') AS impressions,
        COUNT(*) FILTER (WHERE b.action='CLICK') AS clicks
    </sql>
    <select id="scanBuckets" resultMap="bucket" useCache="false">
        SELECT COALESCE(b.bucket,'(none)') AS bucket,<include refid="totals"/>,COUNT(DISTINCT b.user_id) AS users
        FROM <include refid="sourceTable"/> b WHERE b.bucket IS NOT NULL
        <if test="since != null">AND b.ts &gt;= #{since}::timestamp</if>
        <include refid="untilFilter"/><include refid="sceneFilter"/>
        GROUP BY b.bucket ORDER BY impressions DESC
    </select>
    <select id="scanPostPeriod" resultMap="post" useCache="false">
        SELECT COALESCE(b.user_id,0) AS user_id,b.bucket,<include refid="totals"/>,
               MIN(b.ts) FILTER (WHERE b.action='IMPRESSION') AS first_impression
        FROM <include refid="sourceTable"/> b WHERE b.bucket IS NOT NULL AND b.ts &gt;= #{since}::timestamp
        <include refid="untilFilter"/><include refid="sceneFilter"/>
        GROUP BY b.user_id,b.bucket HAVING COUNT(*) FILTER (WHERE b.action='IMPRESSION') &gt; 0
    </select>
    <select id="scanPrePeriod" resultMap="pre" useCache="false">
        SELECT COALESCE(b.user_id,0) AS user_id,<include refid="totals"/>
        FROM <include refid="sourceTable"/> b
        WHERE b.ts &gt;= #{since}::timestamp-(#{preDays}*interval '1 day') AND b.ts &lt; #{since}::timestamp
        <include refid="sceneFilter"/>
        GROUP BY b.user_id HAVING COUNT(*) FILTER (WHERE b.action='IMPRESSION') &gt; 0
    </select>
</mapper>
