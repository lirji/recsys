<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.offline.persistence.mapper.primary.PositiveFeedbackMapper">
    <resultMap id="pair" type="com.recsys.offline.persistence.mapper.primary.PositiveFeedbackMapper$Pair">
        <constructor>
            <arg name="userId" column="user_id" javaType="_long"/>
            <arg name="itemId" column="item_id" javaType="_long"/>
        </constructor>
    </resultMap>
    <resultMap id="weighted" type="com.recsys.offline.persistence.mapper.primary.PositiveFeedbackMapper$Weighted">
        <constructor>
            <arg name="userId" column="user_id" javaType="_long"/>
            <arg name="itemId" column="item_id" javaType="_long"/>
            <arg name="action" column="action" javaType="java.lang.String"/>
            <arg name="value" column="value" javaType="java.lang.Double"/>
            <arg name="epoch" column="ts_epoch" javaType="java.lang.Double"/>
        </constructor>
    </resultMap>
    <sql id="source">
        <choose>
            <when test="filter.source.name() == 'BEHAVIOR_LOG'">behavior_log</when>
            <otherwise>user_behavior</otherwise>
        </choose>
    </sql>
    <sql id="positive">
        WHERE (action IN ('CLICK','LIKE','PLAY') OR (action='RATING' AND value &gt;= #{filter.minRating}))
        <if test="filter.maxTs != null">AND extract(epoch from ts) &lt;= #{filter.maxTs}</if>
    </sql>
    <select id="scanPairs" resultMap="pair" useCache="false">
        SELECT user_id,item_id FROM <include refid="source"/> <include refid="positive"/>
    </select>
    <select id="scanWeighted" resultMap="weighted" useCache="false">
        SELECT user_id,item_id,action,value,extract(epoch from ts) AS ts_epoch
        FROM <include refid="source"/> <include refid="positive"/>
    </select>
    <select id="maxEpoch" resultType="java.lang.Double" useCache="false">
        SELECT max(extract(epoch from ts)) FROM <include refid="source"/> <include refid="positive"/>
    </select>
</mapper>
