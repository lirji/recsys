<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.offline.persistence.mapper.primary.SeedItemMapper">
    <resultMap id="item" type="com.recsys.offline.persistence.mapper.primary.SeedItemMapper$Item">
        <constructor>
            <arg name="itemId" column="item_id" javaType="_long"/>
            <arg name="title" column="title" javaType="java.lang.String"/>
            <arg name="category" column="category" javaType="java.lang.String"/>
        </constructor>
    </resultMap>
    <select id="items" resultMap="item" useCache="false">
        SELECT item_id,title,category FROM
        <choose><when test="source.name() == 'REPLICA'">item_local</when><otherwise>item</otherwise></choose>
    </select>
</mapper>
