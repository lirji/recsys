<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.offline.persistence.mapper.primary.AdQualityMapper">
    <resultMap id="impressions" type="com.recsys.offline.persistence.mapper.primary.AdQualityMapper$Impressions">
        <constructor>
            <arg name="adId" column="ad_id" javaType="_long"/>
            <arg name="count" column="impr" javaType="_double"/>
            <arg name="relevanceSum" column="relsum" javaType="_double"/>
        </constructor>
    </resultMap>
    <resultMap id="count" type="com.recsys.offline.persistence.mapper.primary.AdQualityMapper$Count">
        <constructor>
            <arg name="adId" column="ad_id" javaType="_long"/>
            <arg name="count" column="n" javaType="_double"/>
        </constructor>
    </resultMap>
    <sql id="sourceTable"><choose><when test="source.name() == 'AD_EVENT_LOG'">ad_event_log</when><otherwise>ad_event</otherwise></choose></sql>
    <sql id="timeFilter"><if test="days &gt; 0">AND e.ts&gt;=now()-#{days}*interval '1 day'</if></sql>
    <select id="scanImpressions" resultMap="impressions" useCache="false">
        SELECT COALESCE(e.ad_id,0) AS ad_id,COUNT(*) AS impr,SUM(COALESCE(e.relevance,0)) AS relsum
        FROM <include refid="sourceTable"/> e WHERE e.event_type='IMPRESSION'
        <include refid="timeFilter"/> GROUP BY e.ad_id
    </select>
    <select id="scanClicks" resultMap="count" useCache="false">
        SELECT COALESCE(e.ad_id,0) AS ad_id,COUNT(DISTINCT e.request_id) AS n
        FROM <include refid="sourceTable"/> e WHERE e.event_type='CLICK'
        <include refid="timeFilter"/> GROUP BY e.ad_id
    </select>
    <select id="scanConversions" resultMap="count" useCache="false">
        SELECT COALESCE(e.ad_id,0) AS ad_id,COUNT(DISTINCT e.request_id) AS n
        FROM <include refid="sourceTable"/> e WHERE e.event_type='CONVERSION'
        <include refid="timeFilter"/> GROUP BY e.ad_id
    </select>
</mapper>
