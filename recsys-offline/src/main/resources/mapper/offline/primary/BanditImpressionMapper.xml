<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.offline.persistence.mapper.primary.BanditImpressionMapper">
    <resultMap id="impression" type="com.recsys.offline.persistence.mapper.primary.BanditImpressionMapper$Impression">
        <constructor>
            <arg name="userId" column="user_id" javaType="_long"/>
            <arg name="itemId" column="item_id" javaType="_long"/>
        </constructor>
    </resultMap>
    <select id="load" resultMap="impression" useCache="false">
        SELECT COALESCE(user_id,0) AS user_id,COALESCE(item_id,0) AS item_id FROM
        <choose>
            <when test="source.name() == 'BEHAVIOR_LOG'">behavior_log</when>
            <otherwise>user_behavior</otherwise>
        </choose>
        WHERE action='IMPRESSION'
        <if test="days &gt; 0">AND ts &gt;= now() - (#{days} * INTERVAL '1 day')</if>
        <if test="maxTs != null">AND extract(epoch from ts) &lt;= #{maxTs}</if>
    </select>
</mapper>
