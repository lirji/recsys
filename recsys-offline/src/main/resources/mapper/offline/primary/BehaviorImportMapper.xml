<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.offline.persistence.mapper.primary.BehaviorImportMapper">
    <delete id="deleteScene">
        DELETE FROM user_behavior WHERE scene=#{scene}
    </delete>
    <insert id="insertRatings">
        INSERT INTO user_behavior(user_id,item_id,action,value,scene,bucket,ts) VALUES
        <foreach collection="rows" item="row" separator=",">
            (#{row.userId},#{row.itemId},'RATING',#{row.value},#{row.scene},NULL,#{row.timestamp,jdbcType=TIMESTAMP})
        </foreach>
    </insert>
    <select id="count" resultType="long" useCache="false">
        SELECT count(*) FROM user_behavior
    </select>
</mapper>
