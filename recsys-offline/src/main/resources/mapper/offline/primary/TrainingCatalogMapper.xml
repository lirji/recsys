<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.offline.persistence.mapper.primary.TrainingCatalogMapper">
    <select id="itemIds" resultType="java.lang.Long" useCache="false">
        SELECT item_id FROM
        <choose>
            <when test="table.name() == 'REPLICA'">item_local</when>
            <otherwise>item</otherwise>
        </choose>
    </select>
</mapper>
