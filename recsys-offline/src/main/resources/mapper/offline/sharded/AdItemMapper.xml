<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.offline.persistence.mapper.sharded.AdItemMapper">
    <resultMap id="link" type="com.recsys.offline.persistence.mapper.sharded.AdItemMapper$Link">
        <constructor>
            <arg name="adId" column="ad_id" javaType="_long"/>
            <arg name="itemId" column="item_id" javaType="_long"/>
        </constructor>
    </resultMap>
    <select id="scanLinks" resultMap="link" useCache="false">
        SELECT COALESCE(ad_id,0) AS ad_id,item_id FROM ad WHERE item_id IS NOT NULL
    </select>
</mapper>
