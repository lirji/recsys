<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.advertiser.persistence.mapper.derived.AdvertiserItemEmbeddingMapper">
    <resultMap id="vector" type="com.recsys.advertiser.persistence.mapper.derived.AdvertiserItemEmbeddingMapper$ItemVector">
        <constructor><arg column="embedding" javaType="string"/><arg column="model" javaType="string"/></constructor>
    </resultMap>
    <select id="find" resultMap="vector">SELECT embedding::text AS embedding,model FROM item_embedding WHERE item_id=#{itemId}</select>
    <select id="text" resultType="string">SELECT embedding::text FROM item_embedding WHERE item_id=#{itemId}</select>
</mapper>
