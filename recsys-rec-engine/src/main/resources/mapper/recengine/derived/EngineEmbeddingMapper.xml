<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.recengine.persistence.mapper.derived.EngineEmbeddingMapper">
    <resultMap id="affinity" type="com.recsys.recengine.persistence.mapper.derived.EngineEmbeddingMapper$Affinity">
        <constructor><arg column="item_id" javaType="_long"/><arg column="aff" javaType="java.lang.Double"/></constructor>
    </resultMap>
    <resultMap id="itemVector" type="com.recsys.recengine.persistence.mapper.derived.EngineEmbeddingMapper$ItemVector">
        <constructor><arg column="item_id" javaType="_long"/><arg column="embedding" javaType="string"/></constructor>
    </resultMap>
    <select id="userEmbeddingCount" resultType="int">SELECT count(*) FROM user_embedding WHERE user_id=#{userId}</select>
    <select id="affinities" resultMap="affinity">
        SELECT e.item_id, 1 - (e.embedding &lt;=> (SELECT embedding FROM user_embedding WHERE user_id=#{userId})) AS aff
        FROM item_embedding e WHERE e.item_id IN
        <foreach collection="itemIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
    <select id="itemVectors" resultMap="itemVector">
        SELECT item_id, embedding::text AS embedding FROM item_embedding WHERE item_id IN
        <foreach collection="itemIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
