<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.recsys.recengine.persistence.mapper.primary.EngineBehaviorMapper">
    <select id="seenItems" resultType="java.lang.Long">
        SELECT DISTINCT item_id FROM user_behavior WHERE user_id=#{userId} AND action IN ('CLICK','LIKE','PLAY','RATING')
    </select>
    <select id="positiveBehaviorCount" resultType="long">
        SELECT count(*) FROM user_behavior WHERE user_id=#{userId} AND action IN ('CLICK','LIKE','PLAY','RATING')
    </select>
    <insert id="appendExposures">
        INSERT INTO user_behavior(user_id,item_id,action,value,scene,bucket,position,exposure_id) VALUES
        <foreach collection="rows" item="row" separator=",">
            (#{userId},#{row.itemId},#{action},#{row.position},#{scene},#{bucket},#{row.position},#{row.exposureId})
        </foreach>
    </insert>
</mapper>
