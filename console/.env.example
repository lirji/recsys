# 认证模式(构建期烘焙,改后需重启 dev / 重新 build)。前后端必须成对:
#   本地无 Casdoor → legacy + 网关 RECSYS_EDGE_CASDOOR=false(本文件默认)
#   Docker 镜像默认 oidc + 网关 RECSYS_EDGE_CASDOOR=true
# 错配表现为一直 401。oidc 账号 radmin/Radmin@12345、rowner1/Rowner1@12345。
VITE_AUTH_MODE=legacy

# 仅 oidc 模式生效。client_id = Casdoor shared app 的 -org-recsys 派生 id(与网关 casdoor.audiences 的 base 对应)。
VITE_CASDOOR_ISSUER=http://localhost:8000
VITE_CASDOOR_CLIENT_ID=ragshared0client00000001-org-recsys
# 当前 Recsys 仍是单租户；必须与网关 CASDOOR_ORG 和上方 client_id 的 -org- 后缀一致。
VITE_CASDOOR_ORGANIZATION=recsys
VITE_CASDOOR_SCOPE=openid profile offline_access

# 自然推荐/搜索可见曝光；须先按 NATURAL_EXPOSURE_RUNBOOK 启用 sandbox 后端。
VITE_NATURAL_EXPOSURE_SANDBOX_ENABLED=false

# 最终混排可见回执，仅隔离 sandbox；先完成 C10 后端与迁移装配。
VITE_FEED_EXPOSURE_SANDBOX_ENABLED=false

# 新 CPC/OCPC 与 CPA 仅 Sandbox；C11/C12 后端和对应资金能力就绪后再开启。
# CPA 业务提交/查询始终要求真实 advertiser edit/fullyConsistent，ADMIN 不绕过。
VITE_SANDBOX_CLICK_ENABLED=false
VITE_SANDBOX_CONVERSION_ENABLED=false
VITE_SANDBOX_RECONCILIATION_ENABLED=false
